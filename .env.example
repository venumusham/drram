# Airtable Configuration
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id_here
AIRTABLE_TABLE_NAME=your_airtable_table_name_here

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here

# GitHub Configuration (for PR creation)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=github_username_or_org
GITHUB_REPO=netlify_site_repository_name

# Netlify Configuration (optional, if direct deployment needed)
NETLIFY_SITE_ID=your_netlify_site_id_here
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
